# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-secure-key
DEBUG=False
ALLOWED_HOSTS=site,www.site

# Admin panel
ADMIN_USERNAME=admin
# Leave blank to create an admin manually; otherwise use a unique 12+ character password.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@thekubanych.kg

# Only list the IPs/CIDRs of your actual reverse proxies.
# For nginx on the same host: TRUSTED_PROXY_IPS=127.0.0.1,::1
TRUSTED_PROXY_IPS=
# Docker uses /data. Outside Docker the default is the project directory.
# DATA_DIR=/srv/portfolio-data
# Optional demonstration records on container startup:
SEED_DATA=false

# Optional integrations
SENTRY_DSN=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database (optional - example for Postgres)
# DATABASE_URL=postgres://user:pass@db:5432/dbname
